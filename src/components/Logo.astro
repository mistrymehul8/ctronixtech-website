---
// Mark: an open "C" drawn as a circuit trace, with two terminals and a core node.
interface Props { size?: number }
const { size = 32 } = Astro.props;
---
<svg class="logo-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="14" fill="var(--c-ink)"/>
  <path d="M44 20.5A16 16 0 1 0 44 43.5" fill="none" stroke="var(--c-accent-bright)" stroke-width="6" stroke-linecap="round"/>
  <circle cx="44" cy="20.5" r="4.5" fill="#F8FAFC"/>
  <circle cx="44" cy="43.5" r="4.5" fill="#F8FAFC"/>
  <circle cx="32" cy="32" r="4" fill="var(--c-accent-bright)"/>
</svg>
