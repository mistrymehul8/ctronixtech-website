---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title} description={p.data.summary}>
  <article><section><div class="wrap">
    <p class="eyebrow"><a href="/projects/">Projects</a></p>
    <h1>{p.data.title}</h1>
    <p class="lead">{p.data.summary}</p>
    {p.data.stats.length > 0 && (
      <div class="stats">{p.data.stats.map((s) => <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>)}</div>
    )}
    <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
    <div class="prose"><Content /></div>
  </div></section></article>
</Base>
