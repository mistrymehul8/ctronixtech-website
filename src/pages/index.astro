---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { site } from "../site";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Ctronix Tech" description="Platform engineering, Kubernetes, infrastructure as code and private cloud: reliable platforms, built as code.">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Platform engineering · Kubernetes · Private cloud</p>
      <h1>{site.tagline}</h1>
      <p class="lead">Ctronix Tech designs and runs infrastructure the way production should be run: everything in Git, secured by default, monitored, and restore-tested. From Kubernetes platforms to a family's private cloud.</p>
      <p class="cta"><a class="btn" href="/projects/">See the work</a> <a class="btn secondary" href="/contact/">Get in touch</a></p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <h2>Selected projects</h2>
      <div class="grid">
        {projects.map((p) => (
          <article class="card">
            <h3><a class="stretched" href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            <ul class="tags">{p.data.tags.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="principles">
    <div class="wrap">
      <h2>How we work</h2>
      <div class="grid">
        <div class="card"><h3>Everything as code</h3><p>Servers, clusters, networks and policies live in Git. Every change is a reviewed pull request with a plan.</p></div>
        <div class="card"><h3>Secure by default</h3><p>Single sign-on with MFA, least privilege, network isolation, and policies that fail closed.</p></div>
        <div class="card"><h3>Proven recovery</h3><p>Backups are only real once restored. Every backup type is restore-tested and documented.</p></div>
        <div class="card"><h3>Costs you can predict</h3><p>Budgets, alerts and lifecycle rules, so the bill matches the plan.</p></div>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 5rem 0 3rem; background: linear-gradient(180deg, var(--c-surface), var(--c-bg)); border-bottom: 1px solid var(--c-border); }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.75rem; }
</style>
