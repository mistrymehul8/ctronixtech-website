---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---
<Base title="Contact" description="Contact Ctronix Tech.">
  <section><div class="wrap prose">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk</h1>
    <p class="lead">Tell us briefly what you run today and what you'd like it to become. We reply within two business days.</p>
    <p><a class="btn" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    <p>Security issue on this site? See our <a href="/.well-known/security.txt">security.txt</a>.</p>
  </div></section>
</Base>
